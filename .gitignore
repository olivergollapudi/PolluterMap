# --- Raw EPA downloads ---------------------------------------------------
# These are large (the national ECHO file is hundreds of MB) and can always be
# re-downloaded, so keep them out of git. The .gitkeep file keeps the empty
# folder in the repo so the layout is obvious to anyone who clones it.
data/raw/*
!data/raw/.gitkeep

# Zip archives anywhere in the project (downloads, accidental copies)
*.zip

# --- Processed database ------------------------------------------------------
# indiana.sqlite holds the same tables as the CSVs next to it, but outgrew GitHub's
# 100 MB file limit. The CSVs are committed; rebuild the database with
# `python3 scripts/build_all.py`.
data/processed/*.sqlite

# --- Python --------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# --- OS / editor clutter ---------------------------------------------------
.DS_Store
.vscode/
.idea/
